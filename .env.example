# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://badminton:badminton_dev_pw@localhost:5432/badminton_dev?schema=public"

# Auth.js (NextAuth v5) session signing secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-me"

# Base URL of the deployed app (used for callback URLs). Not required in local dev.
# AUTH_URL="http://localhost:3000"

# Anthropic API key, required starting M3 (AI Coach). Not used yet.
# ANTHROPIC_API_KEY=""

# Per-video upload size limit in bytes. Optional — defaults to 750 MB
# (786432000). See docs/VIDEO_INTELLIGENCE.md "Known limitations".
# MAX_VIDEO_UPLOAD_BYTES="786432000"

# Base URL of the Python computer-vision service (M5, see cv-service/ and
# docs/CV_ARCHITECTURE.md). Unset = CVAnalysisEngine falls back to
# NullCvEngine (honest "unavailable", not a fabricated result) — this is
# the correct default for CI and any environment that hasn't started
# cv-service. Run it locally with:
#   cd cv-service && python3 -m venv .venv && source .venv/bin/activate
#   pip install -r requirements.txt && uvicorn app.main:app --port 8000
# CV_SERVICE_URL="http://127.0.0.1:8000"

# Shared-secret header cv-service checks on /analyze when set (defense in
# depth only — the service is never internet-facing). Must match
# CV_SERVICE_TOKEN in cv-service's own environment if you set one there.
# CV_SERVICE_TOKEN=""
