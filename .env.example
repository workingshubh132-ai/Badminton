# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://badminton:badminton_dev_pw@localhost:5432/badminton_dev?schema=public"

# Auth.js (NextAuth v5) session signing secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-me"

# Base URL of the deployed app (used for callback URLs). Not required in local dev.
# AUTH_URL="http://localhost:3000"

# Anthropic API key, required starting M3 (AI Coach). Not used yet.
# ANTHROPIC_API_KEY=""

# Per-video upload size limit in bytes. Optional — defaults to 750 MB
# (786432000). See docs/VIDEO_INTELLIGENCE.md "Known limitations".
# MAX_VIDEO_UPLOAD_BYTES="786432000"
