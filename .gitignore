# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# testing artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# locally stored video files (dev-only local storage provider — never commit athlete video)
/storage/

# cv-service (Python) — its own venv/caches, never the source, tests, or
# the small committed synthetic fixtures/model file.
/cv-service/.venv/
/cv-service/**/__pycache__/
/cv-service/.pytest_cache/
*.pyc

# dataset_v1 — third-party source footage and any stills derived from it are never
# committed. Derived frames/contact sheets are still copies of the footage, so they
# stay local too. Only measured facts (sources.json, metadata/, analysis/) and the
# reports are tracked.
/dataset_v1/incoming/*
!/dataset_v1/incoming/README.md
/dataset_v1/frames/
/dataset_v1/contact_sheets/

# Same rule if footage is staged inside the eval package instead of the repo-root
# dataset_v1/ tree: raw video is never committed from either location.
/cv-service/eval/dataset_v1/incoming/
/dataset_v1/quarantine_license_review/
